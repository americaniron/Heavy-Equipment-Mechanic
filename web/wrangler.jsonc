{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fixmyiron-web-staging",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-01-15",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    "NEXT_PUBLIC_API_URL": "https://fixmyiron-api-staging.americanironadmin.workers.dev",
    "NEXT_PUBLIC_PADDLE_ENVIRONMENT": "sandbox",
    "NEXT_PUBLIC_CLERK_SIGN_IN_URL": "https://accounts.fixmyiron.com/sign-in",
    "NEXT_PUBLIC_CLERK_SIGN_UP_URL": "https://accounts.fixmyiron.com/sign-up",
    "NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL": "/portal",
    "NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL": "/portal",
    // Browser-safe by design (these ship in the public client bundle).
    // Decoded clerk pk → "clerk.fixmyiron.com$" — matches the Clerk
    // production instance whose frontend API DNS points at clerk.fixmyiron.com.
    "NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY": "pk_live_Y2xlcmsuZml4bXlpcm9uLmNvbSQ",
    // Paddle DEFERRED — placeholder kept so client code can read a defined
    // string. Replace with real test_… token when Paddle integration ships
    // (see DEPLOY_NOTES.md and PRODUCTION_CUTOVER.md "DEFERRED — PADDLE").
    "NEXT_PUBLIC_PADDLE_CLIENT_TOKEN": "test_DEFERRED_PLACEHOLDER"
  }
}
