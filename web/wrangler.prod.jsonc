{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fixmyiron-web-prod",
  "main": ".open-next/worker.js",
  "workers_dev": true,
  "compatibility_date": "2025-01-15",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  // Custom domain — Cloudflare auto-creates DNS + SSL when this is set.
  // www.fixmyiron.com is intentionally NOT here yet: pre-cutover www is
  // CNAME'd to ghs.googlehosted.com (legacy React app on Google Frontend),
  // and wrangler 4.87 has no `override_existing_dns_record` option in the
  // config schema. www is bound separately (see PRODUCTION_CUTOVER.md
  // §www-binding) once an API token with dns_records:edit is available, OR
  // by manually deleting the legacy www CNAME and redeploying with www in
  // this routes array. Apex covers 99% of traffic; www can wait.
  "routes": [
    { "pattern": "fixmyiron.com", "custom_domain": true }
  ],
  "vars": {
    // Canonical API URL — DNS + custom domain bound in Step 6 of the cutover.
    // The workers.dev URL still works as a fallback (workers_dev=true on the
    // API Worker) but client bundles ship with the canonical URL.
    "NEXT_PUBLIC_API_URL": "https://api.fixmyiron.com",
    "NEXT_PUBLIC_PADDLE_ENVIRONMENT": "sandbox",
    "NEXT_PUBLIC_CLERK_SIGN_IN_URL": "https://accounts.fixmyiron.com/sign-in",
    "NEXT_PUBLIC_CLERK_SIGN_UP_URL": "https://accounts.fixmyiron.com/sign-up",
    "NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL": "/portal",
    "NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL": "/portal",
    // Same Clerk production instance for staging and prod (clerk.fixmyiron.com$).
    "NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY": "pk_live_Y2xlcmsuZml4bXlpcm9uLmNvbSQ",
    // Paddle DEFERRED — placeholder kept so client code can read a defined
    // string. Replaced when Paddle integration ships (see PRODUCTION_CUTOVER.md §11).
    "NEXT_PUBLIC_PADDLE_CLIENT_TOKEN": "test_DEFERRED_PLACEHOLDER",
    // Phase-1 video URL — managed r2.dev subdomain on fixmyiron-media-prod.
    // Phase-2 (Step 10) swaps to https://media.fixmyiron.com/learn-more.mp4
    // after the custom domain is bound to the bucket.
    "NEXT_PUBLIC_LEARN_MORE_VIDEO_URL": "https://pub-45f1719d47e44578968ba4a7d64d597f.r2.dev/learn-more.mp4"
  }
}
