# Heavy-Equipment-Mechanic — environment variables
# Copy to .env locally; in Cloud Run, mount each as a secret env var.
# 19 variables total (matches the count in MIGRATION-STATUS.md).

# --- Runtime ---
NODE_ENV=production
PORT=8080

# --- Database (Neon) ---
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# --- Auth ---
ADMIN_PASSWORD=change-me

# --- AI providers ---
AI_INTEGRATIONS_OPENAI_API_KEY=sk-...
AI_INTEGRATIONS_OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_API_KEY=sk-ant-...

# --- Avatar / video ---
DID_API_KEY=
HEYGEN_API_KEY=

# --- CRM sync ---
CRM_SYNC_API_KEY=

# --- Email (Resend) ---
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=noreply@example.com

# --- Email (SMTP fallback) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# --- SMS (Twilio) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
