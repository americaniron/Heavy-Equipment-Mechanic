# Worker (workers/api) — set via `wrangler secret put` for staging/prod;
# put values in .dev.vars (gitignored) for local `wrangler dev`.
ANTHROPIC_API_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
PADDLE_PRICE_PRO=
PADDLE_PRICE_SHOP=

# Worker plain vars (also in wrangler.toml [vars])
PADDLE_ENVIRONMENT=sandbox
CLERK_ACCOUNT_PORTAL_URL=https://accounts.fixmyiron.com
WEB_ORIGIN=

# Cloudflare deploy (used by wrangler CLI; do NOT commit values)
CF_ACCOUNT_ID=
CF_API_TOKEN=

# Web (web/.env.local for local dev; Pages env vars for deploy)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
NEXT_PUBLIC_PADDLE_ENVIRONMENT=sandbox
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=https://accounts.fixmyiron.com/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=https://accounts.fixmyiron.com/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/portal
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/portal
