# Worker (workers/api) — set via `wrangler secret put` for staging/prod;
# put values in .dev.vars (gitignored) for local `wrangler dev`.
ANTHROPIC_API_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=
OPENAI_API_KEY=
HEYGEN_API_KEY=
LIVEAVATAR_API_KEY=
LIVEAVATAR_OPENAI_SECRET_ID=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_SHOP=
STRIPE_PUBLISHABLE_KEY=

# Worker plain vars (also in wrangler.toml [vars])
APP_ENV=staging
WEB_ORIGIN=http://localhost:5173
PUBLIC_BASE_URL=https://www.fixmyiron.com

# Cloudflare deploy (used by wrangler CLI; do NOT commit values)
CF_ACCOUNT_ID=
CF_API_TOKEN=

# Historical Paddle keys are obsolete. Stripe is the billing provider.
# PADDLE_* secrets may still exist on the Worker; they are unused.

# Web (legacy Next.js portal worker — not the production apex SPA)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
NEXT_PUBLIC_API_URL=https://api.fixmyiron.com
NEXT_PUBLIC_CLERK_SIGN_IN_URL=https://www.fixmyiron.com/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=https://www.fixmyiron.com/register
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/portal
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/portal
